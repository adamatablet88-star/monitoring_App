{
  "rules": {
    ".read": "auth != null",
    ".write": false,

    "meta": {
      "setupComplete": {
        ".read": true,
        ".write": "!data.exists() && newData.val() === true"
      }
    },
    "users": {
      ".read": "root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".read": "auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin'",
        ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin' || (root.child('meta').child('setupComplete').val() !== true && auth.uid === $uid && newData.child('role').val() === 'admin')"
      }
    },

    "clients": { "$id": { ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'" } },
    "sites": { "$id": { ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'" } },
    "tanks": { "$id": { ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'" } },
    "treatmentSystems": { "$id": { ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'" } },
    "parameterConfigs": { "$id": { ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'" } },
    "frequencySettings": { "$id": { ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'" } },
    "regulatoryReports": { "$id": { ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'" } },
    "scheduledSpecialTests": { "$id": { ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'" } },

    "structureAuditLog": {
      "$id": {
        ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin' && !data.exists() && newData.exists()"
      }
    },

    "wells": {
      "$id": {
        ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin' || (data.exists() && newData.exists())"
      }
    },
    "treatmentWells": {
      "$id": {
        ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin' || (data.exists() && newData.exists())"
      }
    },
    "groundwaterWells": {
      "$id": {
        ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin' || (data.exists() && newData.exists())"
      }
    },

    "fuelLensVisits": {
      "$id": {
        ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin' || (!data.exists() && newData.exists() && newData.child('createdBy').val() === auth.uid) || (data.exists() && data.child('createdBy').val() === auth.uid && (now - data.child('createdAt').val()) < 86400000)"
      }
    },
    "sveSystemVisits": {
      "$id": {
        ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin' || (!data.exists() && newData.exists() && newData.child('createdBy').val() === auth.uid) || (data.exists() && data.child('createdBy').val() === auth.uid && (now - data.child('createdAt').val()) < 86400000)"
      }
    },
    "bioVentingSystemVisits": {
      "$id": {
        ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin' || (!data.exists() && newData.exists() && newData.child('createdBy').val() === auth.uid) || (data.exists() && data.child('createdBy').val() === auth.uid && (now - data.child('createdAt').val()) < 86400000)"
      }
    },
    "groundwaterVisits": {
      "$id": {
        ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin' || (!data.exists() && newData.exists() && newData.child('createdBy').val() === auth.uid) || (data.exists() && data.child('createdBy').val() === auth.uid && (now - data.child('createdAt').val()) < 86400000)"
      }
    },

    "activeStatuses": {
      "$id": {
        ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin' || (newData.exists() && newData.child('source').val() === root.child('users').child(auth.uid).child('role').val())"
      }
    }
  }
}
