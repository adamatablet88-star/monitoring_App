# Copy this file to .env.local for local development, and set the same
# values as build-time environment variables in Netlify's site settings
# for deploys (Next.js inlines NEXT_PUBLIC_* vars into the client bundle
# at build time — they aren't read at runtime on the server, since this
# app has none).
#
# Find these values in the Firebase console: Project settings (gear icon)
# → General → "Your apps" → the web app's config snippet.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# Realtime Database, not Firestore — copy this from the Realtime
# Database page in the console (e.g. https://<project>-default-rtdb.<region>.firebasedatabase.app)
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
